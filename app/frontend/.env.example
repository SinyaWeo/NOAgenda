# Base URL the browser uses to reach the API. Baked into the bundle at BUILD time.
# Production behind the reverse proxy (same origin):  /api
# Local development (backend on :3000):                http://localhost:3000
VITE_API_BASE=http://localhost:3000

# Shown on the Terms and Privacy pages (build-time). Leave empty in development.
# VITE_OPERATOR_NAME=Example Ltd, 1 Main Street, Prague
# VITE_CONTACT_EMAIL=privacy@example.com
