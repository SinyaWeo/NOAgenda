{
  "compilerOptions": {
    "module": "nodenext",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "es2022",
    // es2022 would define class fields with [[Define]] semantics, which shadows the properties TypeORM
    // and class-validator install on entities/DTOs. Keep the classic assignment behaviour.
    "useDefineForClassFields": false,
    "skipLibCheck": true,
    "types": ["node", "jest"],
    "sourceMap": true,
    "incremental": true,
    "strict": true,
    "rootDir": "./src",
    "outDir": "dist",
    "paths": {
      "@common/*": ["./src/common/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
