# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# --- Database ---
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=noagenda
DB_PASSWORD=change_me
DB_DATABASE=noagenda

# Schema management. Local dev: tables are auto-synced (default when NODE_ENV != production).
# Production (NODE_ENV=production): auto-sync is OFF and pending migrations in src/migrations
# run on startup. Override either behavior explicitly if needed:
# DB_SYNCHRONIZE=false
# DB_MIGRATIONS_RUN=true
# After changing an entity:  npm run migration:generate -- src/migrations/<Name>

# --- Server ---
# NODE_ENV=production enforces: JWT_SECRET >= 32 chars, CORS_ORIGIN set, schema sync off.
# NODE_ENV=production
# PORT=3000
# Number of reverse-proxy hops in front of the app (default 1 in production, 0 otherwise).
# Needed so rate limiting sees the real client IP.
# TRUST_PROXY=1

# --- JWT ---
# Generate a strong random secret, e.g.: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_secret

# --- CORS ---
# URL of the frontend (used by the backend to allow cross-origin requests)
CORS_ORIGIN=http://localhost:5173

# --- Admin ---
# There is no default admin. Register normally, then promote that account:
#   npm run admin:promote -- <username>        (docker: see DEPLOYMENT.md)
