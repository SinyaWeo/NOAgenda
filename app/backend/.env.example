# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# --- Database ---
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=noagenda
DB_PASSWORD=change_me
DB_DATABASE=noagenda

# Schema management. Local dev: tables are auto-synced (default when NODE_ENV != production).
# Production (NODE_ENV=production): auto-sync is OFF and pending migrations in src/migrations
# run on startup. Override either behavior explicitly if needed:
# DB_SYNCHRONIZE=false
# DB_MIGRATIONS_RUN=true
# After changing an entity:  npm run migration:generate -- src/migrations/<Name>

# --- Server ---
# NODE_ENV=production enforces: JWT_SECRET >= 32 chars, CORS_ORIGIN set, schema sync off.
# NODE_ENV=production
# PORT=3000
# Number of reverse-proxy hops in front of the app (default 1 in production, 0 otherwise).
# Needed so rate limiting sees the real client IP.
# TRUST_PROXY=1

# --- JWT ---
# Generate a strong random secret, e.g.: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_secret

# --- Email (password reset + address verification) ---
# Without SMTP_HOST nothing is sent: messages are written to the log (handy in development)
# and email verification is NOT enforced. With it set, verification is required by default.
# SMTP_HOST=localhost
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=NOAgenda <no-reply@example.com>
# REQUIRE_EMAIL_VERIFICATION=true
# Base URL of the frontend, used for the links in emails (defaults to CORS_ORIGIN).
# PUBLIC_URL=http://localhost:5173

# --- Accounts ---
# Soft launch: restrict who can sign up. REGISTRATION_ENABLED=false closes registration entirely;
# REGISTRATION_INVITE_CODE requires that code to register (give it to the people you invite;
# use a long random value, e.g. `openssl rand -hex 12`). Existing users are not affected.
# REGISTRATION_ENABLED=true
# REGISTRATION_INVITE_CODE=
# Reject registrations that do not send acceptTerms=true (the UI always asks).
# REQUIRE_TERMS_ACCEPTANCE=true
# Days between "delete my account" and the permanent purge (users can cancel meanwhile).
# ACCOUNT_DELETION_GRACE_DAYS=7

# --- Sessions ---
# Access tokens are short-lived; the refresh cookie (httpOnly, rotating) keeps you signed in.
# ACCESS_TOKEN_TTL=15m
# REFRESH_TOKEN_TTL_DAYS=30
# Path the refresh cookie is sent to. Behind a proxy that serves the API under /api: /api/auth
# REFRESH_COOKIE_PATH=/auth
# Account lockout after this many consecutive failed logins, for this many minutes.
# MAX_FAILED_LOGINS=5
# LOCKOUT_MINUTES=15

# --- CORS ---
# URL of the frontend (used by the backend to allow cross-origin requests)
CORS_ORIGIN=http://localhost:5173

# --- Admin ---
# There is no default admin. Register normally, then promote that account:
#   npm run admin:promote -- <username>        (docker: see DEPLOYMENT.md)
