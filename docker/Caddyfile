# Reverse proxy + automatic HTTPS (Let's Encrypt). {$DOMAIN} comes from the compose env.
# With DOMAIN=localhost Caddy issues a local self-signed certificate (for testing).
{$DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	# API: /api/* -> backend (the /api prefix is stripped).
	handle_path /api/* {
		request_body {
			max_size 12MB
		}
		reverse_proxy backend:3000
	}

	# Everything else: the web UI.
	handle {
		reverse_proxy frontend:3000
	}
}
