# The ONE shared reverse proxy (docker/docker-compose.edge.yml). It routes by hostname to any number of
# NOAgenda instances, each a separate compose project that joins the `noagenda-edge` network.
#
# One file per instance in docker/sites/ (see sites/example.caddy.example):
#
#   demo.example.net {                  # http://demo.example.net when Apache/nginx terminates TLS in front
#       import noagenda demo            # "demo" = INSTANCE in that instance's env file
#   }
#
# A plain hostname gets an automatic Let's Encrypt certificate (DNS name -> this server, ports 80/443 reachable);
# `localhost` gets a local self-signed one (testing). After adding or changing a site file:
#   docker compose -p noagenda-edge -f docker/docker-compose.edge.yml exec caddy caddy reload --config /etc/caddy/Caddyfile
{
	servers {
		# Keep the client address that a proxy in front of us (Apache/nginx on the same host or
		# network) puts in X-Forwarded-For. Without this Caddy REPLACES it with the proxy's own
		# address, so the backend would see every visitor as one IP and its rate limits and
		# login lockouts would hit all users together. Traffic from the public internet is not
		# trusted, so a visitor still cannot forge their address.
		trusted_proxies static private_ranges

		# Slow-client protection (slowloris): bounded header/body/idle times.
		timeouts {
			read_header 10s
			read_body 2m
			write 2m
			idle 2m
		}
	}
}

# Everything an instance needs. {args[0]} is the instance name: it reaches that instance's containers
# through the network aliases <name>-backend and <name>-frontend (set in docker-compose.prod.yml).
(noagenda) {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	# API: /api/* -> backend (the /api prefix is stripped).
	handle_path /api/* {
		request_body {
			max_size 12MB
		}
		reverse_proxy {args[0]}-backend:3000
	}

	# Everything else: the web UI.
	handle {
		reverse_proxy {args[0]}-frontend:3000
	}
}

import /etc/caddy/sites/*.caddy
