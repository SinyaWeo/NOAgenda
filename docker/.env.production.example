# Copy to docker/.env.production and fill in. Never commit the real file.

# Public hostname of this instance (DNS must point at this server). It is also the site address you put in
# docker/sites/<INSTANCE>.caddy for the shared Caddy (see DEPLOYMENT.md).
DOMAIN=noagenda.example.com

# Short name, unique on this host (letters, digits, dash): app, demo, ... The shared Caddy reaches this instance as
# <INSTANCE>-backend / <INSTANCE>-frontend, so two instances with the same name would receive each other's traffic.
INSTANCE=app

# Strong random values, e.g.:  openssl rand -base64 36
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
# openssl rand -hex 48   (must be >= 32 chars, the backend refuses to start otherwise)
JWT_SECRET=
# Encrypts secrets stored in the database (webhook signing secrets, plugin credentials):  openssl rand -base64 32
# Required, and unique per instance (never copy it into another instance's env file, like JWT_SECRET). Keep a copy OUTSIDE the server's backups: a database backup is useless for these values without it,
# and a stolen backup alone does not reveal them. Rotation: put a new key first and keep the old one after a comma
# (SECRETS_KEY=<new>,<old>), restart, run reencrypt-secrets (see DEPLOYMENT.md), then drop the old key.
SECRETS_KEY=

# Email: needed for password reset and email verification. Use your provider's SMTP
# credentials (SES, Mailgun, Postmark, your own server, ...). Without SMTP_HOST no mail
# is delivered (it is only logged) and email verification is not enforced.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false          # true for port 465
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=NOAgenda <no-reply@noagenda.example.com>
# REQUIRE_EMAIL_VERIFICATION=   # default: on when SMTP_HOST is set, off otherwise

# Shown on the Terms of Service and Privacy Policy pages (baked into the frontend at build time:
# rebuild with `up -d --build` after changing). Until both are set the pages show a "template" banner.
# OPERATOR_NAME=Example Ltd, 1 Main Street, Prague
# CONTACT_EMAIL=privacy@noagenda.example.com

# Require the "I accept the Terms and Privacy Policy" box on the API side too (the UI always shows it).
# REQUIRE_TERMS_ACCEPTANCE=true

# Soft launch: who may sign up. Default is anyone. To invite people, set a long random code and share it
# with them (the register page then asks for it); to stop sign-ups completely, set REGISTRATION_ENABLED=false.
# Existing users are not affected either way.
# REGISTRATION_INVITE_CODE=          # openssl rand -hex 12
# REGISTRATION_ENABLED=false

# Optional
# MYSQL_DATABASE=noagenda
# MYSQL_USER=noagenda
# Only when not using the default https://$DOMAIN origin (e.g. a non-standard port):
# PUBLIC_ORIGIN=https://noagenda.example.com:8443
#
# Behind an existing reverse proxy (Apache with certbot) that terminates TLS: set TRUST_PROXY=2 (proxy + Caddy).
# Users must still reach the site via https://$DOMAIN (the proxy handles that). Ports belong to the shared Caddy: .env.edge.
# TRUST_PROXY=2

# Prebuilt images (CI publishes them to GHCR; docker/deploy.sh pulls and sets IMAGE_TAG for you).
# IMAGE_REPO=ghcr.io/<github-owner-lowercase>/noagenda
# IMAGE_TAG=latest
# MariaDB buffer pool: 256M is right for a 2-4 GB server; use 128M on 1 GB, more on a big machine.
# MARIADB_BUFFER_POOL=256M

# Small server (about 1 GB RAM, with swap): tighter container limits. Check `docker stats --no-stream` afterwards.
# MARIADB_BUFFER_POOL=128M
# BACKEND_MEM_LIMIT=384m
# FRONTEND_MEM_LIMIT=256m

# --- Public demo instance (a second stack on the same host, see DEPLOYMENT.md) ---
# Own INSTANCE, DOMAIN, JWT_SECRET, SECRETS_KEY and DB passwords (and its own docker/sites/<INSTANCE>.caddy), plus:
# DEMO_MODE=true              # login page lists the example users; password/email/deletion endpoints are blocked
# REGISTRATION_ENABLED=false
# Leave SMTP_HOST empty. Reset nightly with docker/demo-reset.sh (cron: 0 0 * * *).
