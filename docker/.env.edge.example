# Copy to docker/.env.edge (the shared Caddy, docker-compose.edge.yml). Never commit the real file.
# Defaults: Caddy owns 80/443 and gets the Let's Encrypt certificates itself.

# Behind an existing reverse proxy (Apache/nginx) that owns 80/443 and terminates TLS:
# BIND_ADDR=127.0.0.1
# HTTP_PORT=8080
# HTTPS_PORT=8443         # unused, but keep it off 443 so it does not clash with the proxy

# CADDY_MEM_LIMIT=128m
