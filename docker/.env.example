# Copy this file to .env and fill in values before running docker compose.
# Never commit .env to version control.
# Leave nothing empty: docker compose refuses to start until both passwords are set.
# Generate each one with:  openssl rand -base64 24

# MariaDB credentials — required
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=

# Optional: override defaults
MYSQL_DATABASE=noagenda
MYSQL_USER=noagenda
